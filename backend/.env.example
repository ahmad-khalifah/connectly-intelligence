# Copy to backend/.env and adjust if needed. These defaults match docker-compose.yml.
CONNECTLY_DATABASE_URL=postgresql+psycopg://connectly:connectly@localhost:5432/connectly
CONNECTLY_TEST_DATABASE_URL=postgresql+psycopg://connectly:connectly@localhost:5432/connectly_test
CONNECTLY_CORS_ORIGINS=http://localhost:3000
# Signs session tokens. Required in production; at least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONNECTLY_SECRET_KEY=
# development or production (production disables /docs and requires the secret key)
CONNECTLY_ENVIRONMENT=development
# How long a sign-in lasts, in minutes
CONNECTLY_ACCESS_TOKEN_MINUTES=480
# Set to true only when the API is reachable solely through the web app or a reverse proxy
# that sets X-Forwarded-For; used for per-address sign-in limits.
CONNECTLY_TRUST_PROXY_HEADERS=false
# Optional language model for brief summaries: none (default), gemini (free tier, see below),
# ollama or openai_compatible (free self-hosted servers: Ollama, llama.cpp, vLLM, LM Studio).
CONNECTLY_AI_PROVIDER=none
CONNECTLY_AI_BASE_URL=http://localhost:11434
CONNECTLY_AI_MODEL=llama3.1:8b
# CONNECTLY_AI_API_KEY=
# Optional: Gemini research intelligence (docs/research.md). Free tier only.
# Create the key in Google AI Studio in a Google Cloud project with NO billing account linked.
# CONNECTLY_GEMINI_API_KEY=
CONNECTLY_GEMINI_SEARCH_MODEL=gemini-2.5-flash
CONNECTLY_GEMINI_TEXT_MODEL=gemini-2.5-flash
# Connectly's own daily limits (US Pacific days), kept below Google's free-tier limits.
CONNECTLY_GEMINI_DAILY_SEARCH_LIMIT=200
CONNECTLY_GEMINI_DAILY_REQUEST_LIMIT=200
CONNECTLY_GEMINI_PER_MINUTE_LIMIT=5
