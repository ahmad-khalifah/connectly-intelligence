# Settings for `docker compose --profile app` (copy to .env; never commit .env).

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONNECTLY_SECRET_KEY=
# Database password used by all containers.
POSTGRES_PASSWORD=change-me
# Session cookies are HTTPS-only. Set to false only for http://localhost testing.
COOKIE_SECURE=false
# Number of reverse proxies in front of the web app (0 when it is reached directly).
TRUSTED_PROXY_HOPS=0
# Optional self-hosted model (see docs/ai.md): none, ollama or openai_compatible.
CONNECTLY_AI_PROVIDER=none
