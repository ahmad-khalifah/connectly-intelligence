# Copy to frontend/.env.local if the API is not on http://localhost:8000.
# Address the Next.js server uses to reach the API (the browser never calls the API directly).
API_URL=http://localhost:8000

# Session cookies are HTTPS-only in production builds. Set to false only to test a production
# build over plain http on your own machine.
# COOKIE_SECURE=false

# Optional basemap under the boundary layers: any MapLibre style URL that is free to use.
# Leave unset to draw boundaries on a plain background (no tile service, works offline).
# NEXT_PUBLIC_BASEMAP_STYLE_URL=
